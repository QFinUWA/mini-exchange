FROM golang:1.25-alpine AS build
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /exchange-server .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 1001 exchange
COPY --from=build /exchange-server /usr/local/bin/exchange-server
# State (exchange_data.json) and recorded Parquet files (data/) live in the volume.
WORKDIR /data
RUN chown exchange /data
USER exchange
EXPOSE 3211
CMD ["exchange-server"]
